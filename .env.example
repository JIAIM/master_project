POSTGRES_USER=edu
POSTGRES_PASSWORD=edu_password
POSTGRES_DB=edu_platform

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- LLM: Groq ---
GROQ_API_KEY=
LLM_GENERATOR_MODEL=openai/gpt-oss-120b
LLM_CRITIC_MODEL=qwen/qwen3.8-27b
LLM_SOLVER_MODEL=openai/gpt-oss-20b
LLM_REQUESTS_PER_SECOND=2.0
GROQ_TOKENS_PER_MINUTE=7200
GROQ_MAX_COMPLETION_TOKENS=2500
GENERATION_CONCURRENCY=4
ENABLE_SOLVER=true

# --- LLM: резервні провайдери (необов'язково) ---
GOOGLE_API_KEY=
LLM_GEMINI_MODEL=gemini-flash-latest
CEREBRAS_API_KEY=
LLM_CEREBRAS_MODEL=gpt-oss-120b
OPENROUTER_API_KEY=
LLM_OPENROUTER_MODELS=qwen/qwen3.8-27b:free,z-ai/glm-5.2:free,google/gemma-4-31b-it:free

# --- Верифікація ---
MAX_VERIFICATION_ATTEMPTS=3
CRITIC_MIN_GROUNDING=0.7
CRITIC_MIN_DISTRACTOR_QUALITY=0.6
CRITIC_MIN_CLARITY=0.6

# --- RAG ---
EMBEDDING_MODEL=intfloat/multilingual-e5-base
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Google Форми ---
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# --- Сервер ---
PUBLIC_PORT=4053
PUBLIC_HOST=77.47.192.6
